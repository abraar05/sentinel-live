<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Storage Configuration"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set the base directory for all recordings. Supports NAS UNC paths and mounted network drives."
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/et_base_dir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="\\\\nas\\share\\recordings or /mnt/nas/recordings"
        android:inputType="text"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save" />

</LinearLayout>
